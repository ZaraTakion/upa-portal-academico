# Generate a private production key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Leave empty to use the local SQLite database. Production should set PostgreSQL.
DATABASE_URL=

# SMTP settings for password reset email.
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

ACADEMIC_FILE_MAX_SIZE=26214400
DB_CONN_MAX_AGE=60
PASSWORD_RESET_TIMEOUT=3600
LOGIN_THROTTLE_RATE=5/min
ANON_THROTTLE_RATE=5/hour
LOG_LEVEL=INFO
