# Generate a private production key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Leave empty to use the local SQLite database. Production should set PostgreSQL.
DATABASE_URL=

# SMTP settings for password reset email.
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

ACADEMIC_FILE_MAX_SIZE=26214400
DB_CONN_MAX_AGE=60
PASSWORD_RESET_TIMEOUT=3600
LOGIN_THROTTLE_RATE=5/min
ANON_THROTTLE_RATE=5/hour
LOG_LEVEL=INFO

# Local development uses SQLite and local uploads. Production must configure
# PostgreSQL and either a persistent mounted MEDIA_ROOT or private S3 storage.
USE_S3_STORAGE=False
ALLOW_SQLITE_DATABASE=True
ALLOW_LOCAL_MEDIA_STORAGE=True
MEDIA_ROOT=media

# S3-compatible private object storage (only required when USE_S3_STORAGE=True).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_QUERYSTRING_EXPIRE=900

# Enable only behind a trusted proxy that overwrites X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=False

# Only enable for isolated synthetic demo databases. Never use in production.
DEMO_MODE=False
# Optional local mail capture for browser tests; no external emails are sent.
# EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# EMAIL_FILE_PATH=/tmp/upa-verification-emails

# Optional path for an isolated local SQLite database.
# SQLITE_DATABASE_PATH=/tmp/upa-local.sqlite3

# Disable uploads on ephemeral hosting until private persistent storage exists.
ACADEMIC_UPLOADS_ENABLED=True
# Only a dedicated private preview may provision synthetic accounts.
CAMPUS_ENVIRONMENT=development
CAMPUS_PREVIEW_BOOTSTRAP=False
# CAMPUS_PREVIEW_STUDENT_PASSWORD, CAMPUS_PREVIEW_TEACHER_PASSWORD,
# CAMPUS_PREVIEW_ADMIN_PASSWORD are provided securely by the hosting platform.
